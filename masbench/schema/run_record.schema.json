    },
    "activations": {
     "default": 0,
     "title": "Activations",
     "type": "integer"
    },
    "llm_calls": {
     "default": 0,
     "title": "Llm Calls",
     "type": "integer"
    },
    "prompt_tokens": {
     "default": 0,
     "title": "Prompt Tokens",
     "type": "integer"
    },
    "completion_tokens": {
     "default": 0,
     "title": "Completion Tokens",
     "type": "integer"
    },
    "transcript": {
