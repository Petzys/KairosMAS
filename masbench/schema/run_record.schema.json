     "title": "Seq",
     "type": "integer"
    },
    "function": {
     "title": "Function",
     "type": "string"
    },
    "args": {
     "additionalProperties": true,
     "title": "Args",
     "type": "object"
    },
    "result": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
