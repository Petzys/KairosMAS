     "title": "Defense Note"
    },
    "t_start": {
     "title": "T Start",
     "type": "number"
    },
    "t_end": {
     "title": "T End",
     "type": "number"
    }
   },
   "required": [
    "agent",
    "seq",
    "function",
    "args",
    "t_start",
    "t_end"
   ],
   "title": "ToolCallRecord",
   "type": "object"
  }
 },
 "additionalProperties": false,
 "properties": {
