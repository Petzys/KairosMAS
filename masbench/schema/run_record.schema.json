     "default": 0,
     "title": "Prompt Tokens",
     "type": "integer"
    },
    "completion_tokens": {
     "default": 0,
     "title": "Completion Tokens",
     "type": "integer"
    }
   },
   "title": "LLMUsage",
   "type": "object"
