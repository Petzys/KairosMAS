    },
    "error": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Error"
    },
    "executed": {
     "default": false,
     "description": "The call reached the environment",
     "title": "Executed",
     "type": "boolean"
    },
    "blocked_by_defense": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Blocked By Defense"
    },
    "defense_note": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
