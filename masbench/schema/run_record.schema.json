     ],
     "title": "Kind",
     "type": "string"
    },
    "t_start": {
     "title": "T Start",
     "type": "number"
    },
    "t_end": {
     "title": "T End",
     "type": "number"
    }
   },
   "required": [
    "agent",
    "kind",
    "t_start",
    "t_end"
   ],
   "title": "Interval",
   "type": "object"
  },
  "LLMUsage": {
   "additionalProperties": false,
   "properties": {
    "calls": {
