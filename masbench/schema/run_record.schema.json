   "items": {
    "additionalProperties": true,
    "type": "object"
   },
   "title": "Sink",
   "type": "array"
  },
  "t_start": {
   "default": 0.0,
   "title": "T Start",
   "type": "number"
  },
  "t_end": {
   "default": 0.0,
   "title": "T End",
   "type": "number"
  }
 },
 "required": [
  "case",
  "scenario",
  "defense",
  "model"
 ],
