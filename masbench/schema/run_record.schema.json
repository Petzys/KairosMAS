{
 "$defs": {
  "AgentStats": {
   "additionalProperties": false,
   "properties": {
    "agent": {
     "title": "Agent",
     "type": "string"
    },
    "activations": {
     "default": 0,
     "title": "Activations",
     "type": "integer"
    },
    "llm_calls": {
     "default": 0,
     "title": "Llm Calls",
     "type": "integer"
    },
    "prompt_tokens": {
     "default": 0,
     "title": "Prompt Tokens",
     "type": "integer"
    },
    "completion_tokens": {
     "default": 0,
     "title": "Completion Tokens",
     "type": "integer"
    },
    "transcript": {
     "items": {
      "additionalProperties": true,
      "type": "object"
     },
     "title": "Transcript",
     "type": "array"
    }
   },
   "required": [
    "agent"
   ],
   "title": "AgentStats",
   "type": "object"
  },
  "Interval": {
   "additionalProperties": false,
   "properties": {
    "agent": {
     "title": "Agent",
     "type": "string"
    },
    "kind": {
     "enum": [
      "llm",
      "tool",
      "blocked_a2a",
      "held",
      "defense"
     ],
     "title": "Kind",
     "type": "string"
    },
    "t_start": {
     "title": "T Start",
     "type": "number"
    },
    "t_end": {
     "title": "T End",
     "type": "number"
    }
   },
   "required": [
    "agent",
    "kind",
    "t_start",
    "t_end"
   ],
   "title": "Interval",
   "type": "object"
  },
  "MessageRecord": {
   "additionalProperties": false,
   "properties": {
    "id": {
     "title": "Id",
     "type": "string"
    },
    "task_id": {
     "description": "A2A task this message opens or answers",
     "title": "Task Id",
     "type": "string"
    },
    "kind": {
     "enum": [
      "request",
      "reply"
     ],
     "title": "Kind",
     "type": "string"
    },
    "sender": {
     "title": "Sender",
     "type": "string"
    },
    "receiver": {
     "title": "Receiver",
     "type": "string"
    },
    "mode": {
     "enum": [
      "sync",
      "async"
     ],
     "title": "Mode",
     "type": "string"
    },
    "sender_seq": {
     "title": "Sender Seq",
     "type": "integer"
    },
    "text": {
     "title": "Text",
     "type": "string"
    },
    "status": {
     "default": "delivered",
     "enum": [
      "delivered",
      "rejected",
      "failed"
     ],
     "title": "Status",
     "type": "string"
    },
    "reason": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Reason"
    },
    "t_sent": {
     "title": "T Sent",
     "type": "number"
    },
    "t_delivered": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "T Delivered"
    }
   },
   "required": [
    "id",
    "task_id",
    "kind",
    "sender",
    "receiver",
    "mode",
    "sender_seq",
    "text",
    "t_sent"
   ],
   "title": "MessageRecord",
   "type": "object"
  },
  "ToolCallRecord": {
   "additionalProperties": false,
   "properties": {
    "agent": {
     "title": "Agent",
     "type": "string"
    },
    "seq": {
     "description": "Per-agent event sequence number",
     "title": "Seq",
     "type": "integer"
    },
    "function": {
     "title": "Function",
     "type": "string"
    },
    "args": {
     "additionalProperties": true,
     "title": "Args",
     "type": "object"
    },
    "result": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Result"
    },
    "error": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Error"
    },
    "blocked_by_defense": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Blocked By Defense"
    },
    "defense_note": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "e.g. 'held' (result was a stub) or 'committed after review'",
     "title": "Defense Note"
    },
    "t_start": {
     "title": "T Start",
     "type": "number"
    },
    "t_end": {
     "title": "T End",
     "type": "number"
    }
   },
   "required": [
    "agent",
    "seq",
    "function",
    "args",
    "t_start",
    "t_end"
   ],
   "title": "ToolCallRecord",
   "type": "object"
  }
 },
 "additionalProperties": false,
 "properties": {
  "format": {
   "const": "mascase/0.1",
   "default": "mascase/0.1",
   "title": "Format",
   "type": "string"
  },
  "case": {
   "title": "Case",
   "type": "string"
  },
  "scenario": {
   "title": "Scenario",
   "type": "string"
  },
  "defense": {
   "title": "Defense",
   "type": "string"
  },
  "defense_options": {
   "additionalProperties": true,
   "title": "Defense Options",
   "type": "object"
  },
  "model": {
   "title": "Model",
   "type": "string"
  },
  "utility": {
   "anyOf": [
    {
     "type": "boolean"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Utility"
  },
  "security": {
   "anyOf": [
    {
     "type": "boolean"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "description": "True = attacker goal met",
   "title": "Security"
  },
  "final_output": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Final Output"
  },
  "error": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Error"
  },
  "agents": {
   "items": {
    "$ref": "#/$defs/AgentStats"
   },
   "title": "Agents",
   "type": "array"
  },
  "tool_calls": {
   "items": {
    "$ref": "#/$defs/ToolCallRecord"
   },
   "title": "Tool Calls",
   "type": "array"
  },
  "messages": {
   "items": {
    "$ref": "#/$defs/MessageRecord"
   },
   "title": "Messages",
   "type": "array"
  },
  "intervals": {
   "items": {
    "$ref": "#/$defs/Interval"
   },
   "title": "Intervals",
   "type": "array"
  },
  "defense_log": {
   "items": {
    "additionalProperties": true,
    "type": "object"
   },
   "title": "Defense Log",
   "type": "array"
  },
  "t_start": {
   "default": 0.0,
   "title": "T Start",
   "type": "number"
  },
  "t_end": {
   "default": 0.0,
   "title": "T End",
   "type": "number"
  }
 },
 "required": [
  "case",
  "scenario",
  "defense",
  "model"
 ],
 "title": "RunRecord",
 "type": "object"
}
