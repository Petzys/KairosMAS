      "additionalProperties": true,
      "type": "object"
     },
     "title": "Transcript",
     "type": "array"
    }
   },
   "required": [
    "agent"
   ],
   "title": "AgentStats",
   "type": "object"
  },
  "DefenseEvent": {
   "additionalProperties": false,
   "description": "One decision of a defense, in a form that is comparable across defenses.",
   "properties": {
    "t": {
     "title": "T",
     "type": "number"
    },
    "hook": {
     "description": "before_tool | after_tool | on_message | on_receive | on_final | isolate | <own>",
     "title": "Hook",
     "type": "string"
    },
    "agent": {
     "title": "Agent",
     "type": "string"
    },
    "target": {
     "default": "",
     "description": "Tool name, peer agent, ...",
     "title": "Target",
     "type": "string"
    },
    "decision": {
     "description": "deny | replace | modify | abort | isolate | flag | ...",
     "title": "Decision",
     "type": "string"
    },
    "reason": {
     "default": "",
     "title": "Reason",
     "type": "string"
    }
   },
   "required": [
    "t",
    "hook",
    "agent",
    "decision"
   ],
   "title": "DefenseEvent",
   "type": "object"
  },
  "Interval": {
