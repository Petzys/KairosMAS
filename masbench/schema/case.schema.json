{
 "$defs": {
  "Attacker": {
   "additionalProperties": false,
   "properties": {
    "position": {
     "description": "SoK adversary position: A1 external content, A3 member agent(s), or both",
     "enum": [
      "A1",
      "A3",
      "A1+A3"
     ],
     "title": "Position",
     "type": "string"
    },
    "goal": {
     "title": "Goal",
     "type": "string"
    },
    "injections": {
     "items": {
      "$ref": "#/$defs/Injection"
     },
     "title": "Injections",
     "type": "array"
    },
    "board_writes": {
     "items": {
      "$ref": "#/$defs/BoardWrite"
     },
     "title": "Board Writes",
     "type": "array"
    },
    "compromised_agents": {
     "items": {
      "$ref": "#/$defs/CompromisedAgent"
     },
     "title": "Compromised Agents",
     "type": "array"
    }
   },
   "required": [
    "position",
    "goal"
   ],
   "title": "Attacker",
   "type": "object"
  },
  "BoardWrite": {
   "additionalProperties": false,
   "description": "Content on a shared board before the run starts (persistence, laundering).",
   "properties": {
    "board": {
     "title": "Board",
     "type": "string"
    },
    "object": {
     "description": "File path, issue id, key",
     "title": "Object",
     "type": "string"
    },
    "content": {
     "title": "Content",
     "type": "string"
    },
    "author": {
     "default": "external",
     "description": "'external' or the id of an agent",
     "title": "Author",
     "type": "string"
    }
   },
   "required": [
    "board",
    "object",
    "content"
   ],
   "title": "BoardWrite",
   "type": "object"
  },
  "Budget": {
   "additionalProperties": false,
   "properties": {
    "max_turns_per_activation": {
     "default": 20,
     "title": "Max Turns Per Activation",
     "type": "integer"
    },
    "max_messages": {
     "default": 40,
     "title": "Max Messages",
     "type": "integer"
    },
    "wall_clock_s": {
     "default": 900.0,
     "title": "Wall Clock S",
     "type": "number"
    }
   },
   "title": "Budget",
   "type": "object"
  },
  "Check": {
   "additionalProperties": false,
   "properties": {
    "ref": {
     "description": "agentdojo:<version>:<suite>:<task_id> | python:<module>:<fn>",
     "title": "Ref",
     "type": "string"
    },
    "reads": {
     "description": "What the check inspects: environment state (incl. the sink log), final answer, tool-call and message trace",
     "items": {
      "enum": [
       "state",
       "output",
       "trace"
      ],
      "type": "string"
     },
     "title": "Reads",
     "type": "array"
    },
    "args": {
     "additionalProperties": true,
     "description": "python checks: keyword arguments",
     "title": "Args",
     "type": "object"
    }
   },
   "required": [
    "ref",
    "reads"
   ],
   "title": "Check",
   "type": "object"
  },
  "CompromisedAgent": {
   "additionalProperties": false,
   "description": "An agent controlled by the attacker (attacker position A3).",
   "properties": {
    "agent": {
     "title": "Agent",
     "type": "string"
    },
    "system_prompt": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Replaces the agent's prompt",
     "title": "System Prompt"
    },
    "instructions": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Appended to the agent's prompt",
     "title": "Instructions"
    }
   },
   "required": [
    "agent"
   ],
   "title": "CompromisedAgent",
   "type": "object"
  },
  "Injection": {
   "additionalProperties": false,
   "description": "Attacker text placed in an environment slot (attacker position A1).",
   "properties": {
    "vector": {
     "title": "Vector",
     "type": "string"
    },
    "attack": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Template id (e.g. important_instructions); rendered at run time",
     "title": "Attack"
    },
    "goal": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Goal inserted into the template",
     "title": "Goal"
    },
    "text": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Literal text; used when attack is None",
     "title": "Text"
    }
   },
   "required": [
    "vector"
   ],
   "title": "Injection",
   "type": "object"
  },
  "Labels": {
   "additionalProperties": false,
   "description": "Facts about a case, used to stratify results. Never shown to agents or defenses.",
   "properties": {
    "source": {
     "title": "Source",
     "type": "string"
    },
    "core_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "B2: stable id in b2_core.csv (B2-07)",
     "title": "Core Id"
    },
    "case_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "B2: id in the attack catalogue",
     "title": "Case Id"
    },
    "primary_class": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Primary Class"
    },
    "origin": {
     "anyOf": [
      {
       "enum": [
        "as-is",
        "adapted",
        "synthetic"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Origin"
    },
    "adversary": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Adversary"
    },
    "sok_paths": {
     "items": {
      "type": "string"
     },
     "title": "Sok Paths",
     "type": "array"
    },
    "sok_risks": {
     "items": {
      "type": "string"
     },
     "title": "Sok Risks",
     "type": "array"
    },
    "delivery": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Delivery"
    },
    "shared_board": {
     "anyOf": [
      {
       "enum": [
        "yes",
        "no",
        "variant"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Shared Board"
    },
    "attack_path": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Agent/board chain the attack must cross",
     "title": "Attack Path"
    },
    "path_agents": {
     "description": "Agent and board ids on attack_path, in order (path check)",
     "items": {
      "type": "string"
     },
     "title": "Path Agents",
     "type": "array"
    },
    "payload_source": {
     "anyOf": [
      {
       "enum": [
        "verbatim",
        "written"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "verbatim = copied from the seed; written = made for this benchmark",
     "title": "Payload Source"
    },
    "seed": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Repo + commit or paper the case comes from",
     "title": "Seed"
    },
    "impl_note": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Impl Note"
    },
    "user_task": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "User Task"
    },
    "injection_task": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Injection Task"
    },
    "sok_path": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Sok Path"
    },
    "attack_class": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Attack Class"
    },
    "workers": {
     "description": "Agents the ground truth uses",
     "items": {
      "type": "string"
     },
     "title": "Workers",
     "type": "array"
    },
    "comm": {
     "anyOf": [
      {
       "enum": [
        "delegation",
        "fan_out",
        "worker_to_worker"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "delegation = one worker; fan_out = several workers, no data between them; worker_to_worker = a later call depends on another agent's earlier read",
     "title": "Comm"
    },
    "reader_agents": {
     "description": "Agents that see an injection",
     "items": {
      "type": "string"
     },
     "title": "Reader Agents",
     "type": "array"
    },
    "actor_agents": {
     "description": "Agents holding the attack tools",
     "items": {
      "type": "string"
     },
     "title": "Actor Agents",
     "type": "array"
    },
    "flow": {
     "anyOf": [
      {
       "enum": [
        "same_agent",
        "cross_agent",
        "mixed",
        "text_only"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Flow"
    }
   },
   "required": [
    "source"
   ],
   "title": "Labels",
   "type": "object"
  },
  "Scoring": {
   "additionalProperties": false,
   "properties": {
    "utility": {
     "$ref": "#/$defs/Check"
    },
    "security": {
     "anyOf": [
      {
       "$ref": "#/$defs/Check"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "None for benign cases"
    }
   },
   "required": [
    "utility"
   ],
   "title": "Scoring",
   "type": "object"
  },
  "UserTurn": {
   "additionalProperties": false,
   "properties": {
    "agent": {
     "description": "Agent that receives the prompt (the entry agent)",
     "title": "Agent",
     "type": "string"
    },
    "prompt": {
     "title": "Prompt",
     "type": "string"
    }
   },
   "required": [
    "agent",
    "prompt"
   ],
   "title": "UserTurn",
   "type": "object"
  }
 },
 "additionalProperties": false,
 "properties": {
  "format": {
   "const": "mascase/0.2",
   "default": "mascase/0.2",
   "title": "Format",
   "type": "string"
  },
  "id": {
   "title": "Id",
   "type": "string"
  },
  "scenario": {
   "title": "Scenario",
   "type": "string"
  },
  "kind": {
   "description": "control = an attack case with one fragment removed; its security check must stay False",
   "enum": [
    "benign",
    "attack",
    "control"
   ],
   "title": "Kind",
   "type": "string"
  },
  "benign_twin": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Benign Twin"
  },
  "control_of": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "description": "control: id of the attack case",
   "title": "Control Of"
  },
  "setup": {
   "additionalProperties": true,
   "description": "Case-specific parameters of the environment's initial state",
   "title": "Setup",
   "type": "object"
  },
  "user": {
   "$ref": "#/$defs/UserTurn"
  },
  "attacker": {
   "anyOf": [
    {
     "$ref": "#/$defs/Attacker"
    },
    {
     "type": "null"
    }
   ],
   "default": null
  },
  "scoring": {
   "$ref": "#/$defs/Scoring"
  },
  "labels": {
   "$ref": "#/$defs/Labels"
  },
  "budget": {
   "$ref": "#/$defs/Budget"
  },
  "script": {
   "anyOf": [
    {
     "additionalProperties": {
      "items": {
       "items": {
        "additionalProperties": true,
        "type": "object"
       },
       "type": "array"
      },
      "type": "array"
     },
     "type": "object"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "description": "Ground truth for `--brain replay`: per agent, one action list per activation. Actions: {tool, args} | {send, text} | {reply}. Attack cases script the attack, benign cases the task. Never shown to agents or defenses.",
   "title": "Script"
  }
 },
 "required": [
  "id",
  "scenario",
  "kind",
  "user",
  "scoring",
  "labels"
 ],
 "title": "Case",
 "type": "object"
}
