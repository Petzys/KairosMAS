# API keys (never commit the filled-in file). Load with:  set -a; . ./.env; set +a
OPENAI_API_KEY=            # GPT-4.1 / GPT-4o / GPT-4o-mini agents, the GPT-4.1 oracle, Progent's policy model
OPENROUTER_API_KEY=        # open-weight agents (Llama, Qwen) and the Qwen3.5 oracles, CaMeL on open models
KAIROS_JUDGE_API_KEY=      # only for an oracle behind --judge-base-url without --judge-api-key-env
SAIA_API_KEY=              # GWDG SAIA (chat-ai.academiccloud.de/v1): MASDojo agents via --agent-api-key-env SAIA_API_KEY

# Which AgentDojo checkout scripts/run_benchmark.py imports. The AutoDojo fork is used by every
# driver script; evaluation/run_agentdojo_gpt41.sh switches to benchmark/agentdojo itself.
KAIROS_BENCHMARK_SRC=./benchmark/autodojo/agentdojo/src

# --- KAIROS MAS / MASDojo (kairos/mas, scripts/run_mas_benchmark.py) ----------------------
# The deterministic MASDojo backend (scripted agents) needs no key at all. LLM agents and the
# LLM oracle read OPENAI_API_KEY (OPENROUTER_API_KEY for vendor/model ids such as
# meta-llama/llama-3.3-70b-instruct). To exercise every LLM code path WITHOUT a key, use the
# offline stub provider: --model stub / --judge-model stub (or KAIROS_JUDGE_MODEL=stub below).
KAIROS_JUDGE_MODEL=        # oracle model for `python -m kairos.mas.serve --oracle llm` (default gpt-4o-mini; `stub` = offline)
KAIROS_JUDGE_BASE_URL=     # OpenAI-compatible endpoint of that oracle (empty = OpenAI)
